# Copy to .env and fill in. Never commit the real .env file.

# --- General ---
INSTA_MAN_PUBLISHER=graph_api          # "graph_api" or "instagrapi"
INSTA_MAN_QUEUE_FILE=content_library/queue.yaml
INSTA_MAN_MAX_HASHTAGS=25
INSTA_MAN_TIMEZONE=Europe/Istanbul

# --- Instagram Graph API (official, recommended) ---
IG_GRAPH_USER_ID=
IG_GRAPH_ACCESS_TOKEN=
IG_GRAPH_API_VERSION=v21.0

# --- instagrapi (unofficial, higher account risk) ---
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_FILE=.ig_session.json
# Optional: route instagrapi traffic through a proxy (recommended: a static
# residential proxy) so login attempts from a VPS/CI IP aren't flagged by
# Instagram's abuse detection. Format: http://user:pass@host:port or
# socks5://user:pass@host:port. Leave empty to disable (default).
IG_PROXY_URL=
